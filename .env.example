# Copy this file to .env and fill in your real Firebase project values.
# Expo automatically exposes any var prefixed EXPO_PUBLIC_ to the app via process.env.
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup and configuration.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Free tier weather API for context-aware suggestions: https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# NOTE: the Gemini API key for food-photo analysis is NOT set here — it must never be
# exposed to the client. Set it server-side only as a Cloud Functions secret instead:
#   firebase functions:secrets:set GEMINI_API_KEY
# Get a free key from https://aistudio.google.com/apikey — see README.md "Food photo analysis".
