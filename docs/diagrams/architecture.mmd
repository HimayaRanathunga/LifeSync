        Firestore[("Cloud Firestore\nusers/{uid}/...")]
        Functions["Cloud Functions v2 (TypeScript)\nrecommendation engine, ML inference,\nfood photo analysis"]
        Rules["Firestore Security Rules\nper-user isolation"]
    end

    subgraph External["External Services"]
        Gemini["Google Gemini API\n(gemini-2.5-flash, vision)"]
        Weather["Weather API"]
    end

    UI --> Services
    Services --> Sensors
    Services -->|"reads/writes"| Firestore
    Services -->|"auth"| Auth
    Services -->|"callable functions"| Functions
    Firestore -. enforced by .-> Rules
