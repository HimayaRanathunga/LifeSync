{
  "name": "lifesync-functions",
  "description": "LifeSync AI recommendation engine — Firebase Cloud Functions",
  "scripts": {
    "build": "tsc",
    "train": "ts-node --transpile-only src/ml/train.ts",
    "train:calories": "ts-node --transpile-only src/food/trainCalorieModel.ts",
    "seed": "ts-node --transpile-only src/seed/seedDatabase.ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^2.17.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "private": true
}
