rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every piece of user data lives under users/{uid}/... — only that user
    // (or a trusted Cloud Function, which uses the Admin SDK and bypasses rules)
    // may read or write it. This is the per-user isolation the Security & Performance
    // rubric criterion asks for.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // recommendations are computed server-side by the Cloud Function (Admin SDK,
        // which bypasses these rules) — clients may read them but never write directly.
        allow write: if request.auth != null && request.auth.uid == uid && subcollection != 'recommendations';
      }
    }
  }
}
